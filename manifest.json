{
  "manifest_version": 3,
  "name": "AdBlock",
  "version": "1.0",
  "description": "Bloque les pub et sécurise la navigation.",
  "permissions": [
    "activeTab",
    "scripting",
    "bookmarks"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}