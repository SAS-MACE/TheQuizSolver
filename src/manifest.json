{
  "manifest_version": 3,
  "name": "Genius AI Quiz Solver",
  "version": "1.0",
  "description": "Appuyez sur 'ù' pour capturer l'écran. L'IA analyse cette image et trouve la réponse à la question posée.",
  "icons": {
    "16": "images/icon128.png",
    "48": "images/icon128.png",
    "128": "images/icon128.png",
    "256": "images/icon128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}